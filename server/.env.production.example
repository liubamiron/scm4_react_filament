# Шаблон .env для деплоя на Plesk (host.md).
#
# Скопировать в server/.env на сервере и заполнить значения в <угловых скобках>.
# APP_KEY сгенерировать локально:  php artisan key:generate --show
# и вставить сюда целиком, вместе с префиксом "base64:".

APP_NAME="IMSP SCM Nr.4"
APP_ENV=production
APP_KEY=<base64:...>
APP_DEBUG=false
APP_URL=https://new.scm4.md

APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Дисковая квота 2 ГБ — debug-уровень быстро раздувает storage/logs.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<имя_бд_из_Plesk>
DB_USERNAME=<пользователь_бд>
DB_PASSWORD=<пароль_бд>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Сессии нужны только админке Filament, привязываем к своему хосту.
SESSION_DOMAIN=new.scm4.md
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Очередь на shared-хостинге некому обрабатывать — выполняем синхронно.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# Клиент и API живут на одном origin, так что CORS в бою фактически не
# задействован. Значение задано явно, чтобы не остаться с "*" из дефолта.
CORS_ALLOWED_ORIGINS=https://new.scm4.md

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@scm4.md"
MAIL_FROM_NAME="${APP_NAME}"
